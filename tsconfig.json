{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "test",
    "*"
  ],
  "exclude": [
    "src/service-worker"
  ],
  "compilerOptions": {
    "paths": {
      "$lib": [
        "./src/lib"
      ],
      "$lib/*": [
        "./src/lib/*"
      ]
    },
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}
