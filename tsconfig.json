{
  "compilerOptions": {
    "paths": {
      "$lib": [
        "./src/lib"
      ],
      "$lib/*": [
        "./src/lib/*"
      ]
    },
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "test",
    "*"
  ],
  "exclude": [
    "src/service-worker",
    "studio",
    "build",
    "node_modules",
    ".svelte-kit"
  ]
}
