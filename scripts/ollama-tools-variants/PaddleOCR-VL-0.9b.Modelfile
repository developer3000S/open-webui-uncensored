# Modelfile generated by "ollama show"
# To build a new Modelfile based on this, replace FROM with:
# FROM wizard-vicuna-uncensored:7b-tools

FROM MedAIBase/PaddleOCR-VL:0.9b
TEMPLATE """{{ if .System }}SYSTEM: {{ .System }}
{{ end }}{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if eq .Role "user" }}USER: {{- if and $.Tools $last }} You have access to the following tools. Use them if needed.

{{ $.Tools }}
{{- end }}

{{ .Content }}
{{ else if eq .Role "assistant" }}ASSISTANT:
{{- if .ToolCalls }}
{{- range .ToolCalls }}{"name": "{{ .Function.Name }}", "parameters": {{ .Function.Arguments }}}{{ end }}
{{- else }}
{{ .Content }}
{{- end }}{{ if not $last }}
{{ end }}
{{- else if eq .Role "tool" }}TOOL RESPONSE: {{ .Content }}
{{ if $last }}ASSISTANT:
{{ end }}
{{- end }}
{{- end }}ASSISTANT:
"""
PARAMETER stop USER:
PARAMETER stop ASSISTANT:


