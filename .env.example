# Шаблон единственного источника настроек деплоя. Скопируйте в .env и заполните.
#
# Всё, что объявлено в .env, имеет приоритет над таблицей config в SQLite:
# строка, сохранённая через Админ → Настройки, перекрывается этим файлом.
# Уберите имя из файла, чтобы вернуть настройку в ведение админки.
#
# Значения по умолчанию, зашитые в Dockerfile и docker-compose, не должны
# дублировать то, что объявлено здесь.
#
# PORT, HOST, FORWARDED_ALLOW_IPS и WEBUI_SECRET_KEY нужны до импорта приложения,
# их читает backend/start.sh — и он же разбирает этот файл (тем же парсером, что
# и env.py), так что дублировать их в окружении контейнера не нужно.
# Осторожно с WEBUI_SECRET_KEY: объявленный здесь он перекрывает уже
# сгенерированный /app/backend/.webui_secret_key (проверено на start.sh), то есть
# перезапуск разлогинит все активные сессии. Не пишите его, если не собираетесь
# намеренно повернуть ключ.



# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
# Для контейнера localhost — это сам контейнер; Ollama на хосте доступна по
# http://host.docker.internal:11434
OLLAMA_BASE_URL='http://host.docker.internal:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ── Встраивание документов ───────────────────────────────────────────────────
# Перечислять ENGINE/MODEL здесь стоит только при фиксированном деплое:
# объявленное имя перестаёт управляться из Админ → Настройки.
# RAG_EMBEDDING_ENGINE='ollama'
# RAG_EMBEDDING_MODEL='qwen3-embedding:0.6b'
# BATCH_SIZE — сколько строк уходит в ОДИН запрос /api/embed (input массивом).
# На CPU это главный рычаг скорости: строки одного запроса считаются одним
# прогоном модели, поэтому фиксированные издержки запроса платятся раз на батч.
# Замер (e5-large, чанки ~400 токенов): batch=1 → 23.6 с/чанк, batch=8 → 12.4
# с/чанк, т.е. ~1.9×. Порядок и значения векторов идентичны одиночным запросам.
# CONCURRENT_REQUESTS — сколько таких запросов идёт одновременно; держите 1,
# иначе CPU-сервер затапливается (503 "server busy", обрывы соединения).
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_CONCURRENT_REQUESTS=1
# Интервал без признаков прогресса, после которого загрузка считается зависшей.
RAG_EMBEDDING_IDLE_TIMEOUT=7200
# Дедлайн одного HTTP-запроса к эмбеддинг-серверу.
RAG_EMBEDDING_REQUEST_TIMEOUT=3600
# Сколько секунд Ollama держит модель в памяти между запросами. Без этого сервер
# выгружает веса через 5 минут простоя, и каждый запрос после паузы платит полную
# цену загрузки модели. Число — секунды; строку без юнита ("7200") Ollama отвергает
# с 400 "missing unit in duration".
RAG_EMBEDDING_KEEP_ALIVE=7200
# Префиксы обязательны для семейства e5 (у запроса и у документа разные) и бесполезны
# для остальных моделей. Ключей в таблице config нет — читаются напрямую из окружения.
# Значение с завершающим пробелом, кавычки его сохраняют.
# RAG_EMBEDDING_QUERY_PREFIX='query: '
# RAG_EMBEDDING_CONTENT_PREFIX='passage: '
# Повторная эмбеддинг-нагрузка побайтово одинакового текста. Хэш хранилища
# (file.hash) — sha256 извлечённого текста, поэтому совпавший хэш означает
# идентичные чанки и взаимозаменяемые векторы: файл-копия получает векторы уже
# проиндексированного оригинала копированием, а не вторым прогоном через
# эмбеддинг-сервер. На CPU это ~12.5 с на чанк в 460 токенов, а корпус обычно
# содержит много дублей (один и тот же документ в .docx и .pdf, несколько копий).
# Экономия не ограничивается дублями: конвейер загрузки индексирует файл сначала
# в коллекцию file-{id}, затем в коллекцию базы знаний — второй проход берёт
# векторы из первого вместо повторного счёта.
# Переиспользование разрешено только при совпадении движка и модели эмбеддинга
# оригинала: векторы другой модели живут в другом пространстве и исказили бы
# поиск молча. Любое расхождение (другая модель, другой сплиттер, отсутствующий
# оригинал) — тихий откат к обычному эмбеддингу, то есть выключать настройку для
# корректности не нужно.
# По умолчанию включена в коде; объявляйте, только чтобы выключить. Ключа в
# таблице config нет — читается напрямую из окружения (как RAG_EMBEDDING_KEEP_ALIVE),
# из Админ → Настройки не управляется.
# RAG_DEDUP_DUPLICATE_FILES='false'

# ── Нарезка на чанки ─────────────────────────────────────────────────────────
# chunk_size считается в токенах, но в каких именно — зависит от TEXT_SPLITTER:
# 'token' считает cl100k_base (дефолт), 'token_transformers' — токенизатором самой
# модели из RAG_TOKENIZER_MODEL. Второе корректно, когда у модели жёсткое окно: у
# multilingual-e5 это 512 её собственных токенов, а cl100k-чанк в 1000 токенов
# превращается в ~1300 — Ollama молча обрезает хвост (truncate=true, без ошибки).
# Пример под e5-large (460 подтверждён экспериментом hit@5 на реальных корпусах;
# overlap — 10% от размера):
# RAG_TEXT_SPLITTER='token_transformers'
# RAG_TOKENIZER_MODEL='intfloat/multilingual-e5-large'
# RAG_CHUNK_SIZE=460
# RAG_CHUNK_OVERLAP=46

# RAG_RERANKING_ENGINE='external'
# RAG_RERANKING_MODEL='qllama/bge-reranker-v2-m3:latest'

# ── Граф знаний (GraphRAG) ───────────────────────────────────────────────────
# Слой поверх RAG: при индексации файла LLM извлекает из чанков сущности и
# связи в Neo4j; при запросе лексический роутер решает, нужен ли граф
# («взаимодействие препаратов», «противопоказания» — граф; «что в приказе» —
# обычный векторный поиск). Векторный поиск не отключается, граф дополняет.
# Требуется Neo4j 5.11+ — нативный векторный индекс, APOC/GDS не нужны.
# Стоимость включения: один вызов LLM на чанк при индексации (документ на
# 900 чанков = 900 вызовов), поэтому по умолчанию выключено.
# GRAPHRAG_ENABLED=false
# auto | always | never — нужен ли граф каждому запросу.
# GRAPHRAG_MODE='auto'
# Модель извлечения (один вызов на чанк — самая быстрая, дающая валидный JSON).
# Замерено на этом хосте (CPU, чанк ~700 токенов, temp=0): qwen3:1.7b — 298 c
# и поймал связку CONTRAINDICATED_IN; qwen3:4b — 316 c, 0 связей. Дефолт 1.7b.
# GRAPHRAG_LLM_MODEL='qwen3:1.7b'
# false для qwen3-семейства: без отключения скрытых рассуждений модель
# возвращает пустой ответ. Пусто = не отправлять поле другим моделям.
# GRAPHRAG_LLM_THINKING=false
# Параллельность извлечения: держите 1 на CPU-Ollama (иначе 503 server busy).
# GRAPHRAG_CONCURRENCY=1
# GRAPHRAG_EXTRACT_TIMEOUT=1800
# GRAPHRAG_MAX_RETRIES=3
# Топ сущностей на запрос и глубина обхода графа при поиске.
# GRAPHRAG_TOP_ENTITIES=6
# GRAPHRAG_TRAVERSAL_DEPTH=2
# GRAPHRAG_NEIGHBOR_LIMIT=12
# Подключение к Neo4j. Приложение и Neo4j поднимаются в общей сети
# open-webui-rus_net (docker-run.sh), поэтому URI — по имени сервиса.
# host.docker.internal для bolt не работает: published-порт сидит на 127.0.0.1.
# Пароль задавайте только в .env.
# NEO4J_URI='bolt://open-webui-neo4j:7687'
# NEO4J_USER='neo4j'
# NEO4J_PASSWORD=''

# Valkey Vector Store (requires VECTOR_DB=valkey)
# Valkey требует поднятого сервера: объявить VECTOR_DB=valkey без него
# означает остановку индексации.
# VECTOR_DB='chroma'
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

# ── Офлайн: походы на huggingface.co ─────────────────────────────────────────
# Причина обращений к HF при индексации — не эмбеддинги (они идут в Ollama), а
# токенизатор из RAG_TOKENIZER_MODEL: он открывается AutoTokenizer.from_pretrained
# с local_files_only = not RAG_EMBEDDING_MODEL_AUTO_UPDATE, а AUTO_UPDATE по
# умолчанию True. Пока он True, каждая нарезка чанков валидирует кэш в сети, даже
# когда кэш полон: HEAD/GET на 307/200 — это только ETag-проверка снапшота, ничего
# не скачивается. Предупреждение "unauthenticated requests, set HF_TOKEN" к этому
# отношения не имеет: оно ложно и на скорость не влияет.
# OFFLINE_MODE обнуляет AUTO_UPDATE (эмбеддинга и реранкера) и ставит
# HF_HUB_OFFLINE=1. Это «без HF», а не «без сети»: запросы к Ollama, Neo4j и
# внешнему реранкеру не затрагиваются.
# Побочные эффекты: выключается проверка новой версии Open WebUI и pip-установка
# зависимостей из frontmatter плагинов/инструментов.
# Условие: кэш моделей должен быть полным — иначе загрузка падает с ошибкой
# вместо тихой подгрузки. При смене RAG_TOKENIZER_MODEL или RAG_EMBEDDING_MODEL
# на некешированную временно поставьте false (или доскачайте снапшот вручную).
# OFFLINE_MODE='true'

# Шум библиотек
# TRANSFORMERS_NO_ADVISORY_WARNINGS=1
# TOKENIZERS_PARALLELISM=false

# ── Возможности моделей и встроенные инструменты ────────────────────────────
# Два независимых слоя, оба необходимы для того, чтобы модель предлагала все
# функции проекта:
#   1. capabilities (model.info.meta.capabilities) — флаги для фронтенда и
#      middleware (отправка файлов, стриминг usage, показ цитат и т.д.);
#   2. builtinTools (model.info.meta.builtinTools) — категории встроенных
#      инструментов, которые middleware добавляет в tools при нативном
#      function-calling. Гейтуются флагами ENABLE_* ниже и разрешениями
#      пользователя, поэтому одной меты недостаточно.
# Применяется ко всем моделям (utils/models.py): capabilities мержатся с
# per-model приоритетом, остальные ключи — только при их отсутствии у модели.
# DEFAULT_MODEL_METADATA='{"capabilities":{"file_context":true,"vision":true,"file_upload":true,"web_search":true,"image_generation":true,"code_interpreter":true,"terminal":true,"citations":true,"status_updates":true,"usage":true,"builtin_tools":true},"builtinTools":{"time":true,"knowledge":true,"chats":true,"memory":true,"web_search":true,"image_generation":true,"code_interpreter":true,"notes":true,"channels":true,"tasks":true,"automations":true,"calendar":true}}'

# Глобальные включатели встроенных инструментов.
# Движок duckduckgo не требует ключа. Подпадают под builtinTools.web_search.
# ENABLE_WEB_SEARCH='true'
# WEB_SEARCH_ENGINE='duckduckgo'
# DDGS_BACKEND='auto'

# Выполнение кода: pyodide (в браузере). Подпадает под builtinTools.code_interpreter.
# ENABLE_CODE_INTERPRETER='true'

# По умолчанию True в коде проекта, здесь закреплены явно для полноты картины.
# ENABLE_NOTES='true'
# ENABLE_CALENDAR='true'
# ENABLE_AUTOMATIONS='true'

# Каналы по умолчанию выключены.
# ENABLE_CHANNELS='true'

# kb_exec/query_knowledge_files: модель выполняет файловые команды
# (ls/tree/cat/grep/find) по базам знаний, а не только поиск по чанкам.
# ENABLE_KB_EXEC='true'

# Генерация и редактирование картинок: capability уже включена в
# DEFAULT_MODEL_METADATA, но для самих инструментов нужен настроенный движок
# (AUTOMATIC1111_BASE_URL или IMAGE_GENERATION_ENGINE='openai' с ключом).
# Без движка кнопка появится, но вызов инструмента вернёт ошибку.
# ENABLE_IMAGE_GENERATION='true'
# ENABLE_IMAGE_EDIT='true'
